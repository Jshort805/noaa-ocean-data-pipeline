[0m02:26:05.643737 [debug] [Thread-1 (]: On model.NOAA_Data_Project.gold_marine_conditions: /* {"app": "dbt", "dbt_version": "1.11.12", "profile_name": "NOAA_Data_Project", "target_name": "dev", "node_id": "model.NOAA_Data_Project.gold_marine_conditions"} */

  
    
    

    create  table
      "NOAA_Data"."main"."gold_marine_conditions__dbt_tmp"
  
    as (
      with tide as (
        select *,
            water_level_ft - avg(water_level_ft) OVER 
            (ORDER BY observed_at ROWS BETWEEN 20 PRECEDING AND 20 FOLLOWING) AS avg_tide_direction
        from "NOAA_Data"."main"."silver_water_data"
 ),
wind as (
    select * from "NOAA_Data"."main"."silver_wind_data"
)

select
    t.observed_at,
    t.water_level_ft,
    w.wind_speed_kts,
    case
        when w.wind_speed_kts is null then null
        when w.wind_speed_kts < 5 then 'calm'
        when w.wind_speed_kts < 12 then 'breezy'
        else 'windy'
    end as wind_category,
    case 
        when t.avg_tide_direction is null then null
        when t.avg_tide_direction < 0 then 'falling'
        when t.avg_tide_direction > 0 then 'rising'
        else 'steady'
    end as tide_direction
from tide t
left join wind w on t.observed_at = w.observed_at
    );
  
  
