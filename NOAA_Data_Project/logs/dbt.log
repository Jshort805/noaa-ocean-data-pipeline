[0m01:41:21.003863 [debug] [Thread-1 (]: On model.NOAA_Data_Project.gold_marine_conditions: /* {"app": "dbt", "dbt_version": "1.11.12", "profile_name": "NOAA_Data_Project", "target_name": "dev", "node_id": "model.NOAA_Data_Project.gold_marine_conditions"} */

  
    
    

    create  table
      "NOAA_Data"."main"."gold_marine_conditions__dbt_tmp"
  
    as (
      with tide as (
    select * from "NOAA_Data"."main"."silver_water_data"
),
wind as (
    select * from "NOAA_Data"."main"."silver_wind_data"
)

select
    t.observed_at,
    t.water_level_ft,
    w.wind_speed_kts,
    t.water_level_ft - lag(t.water_level_ft) over (order by t.observed_at) as tide_delta,
    case
        when t.water_level_ft - lag(t.water_level_ft) over (order by t.observed_at) > 0 then 'rising'
        when t.water_level_ft - lag(t.water_level_ft) over (order by t.observed_at) < 0 then 'falling'
        else 'slack'
    end as tide_direction,
    case
        when w.wind_speed_kts < 5 then 'calm'
        when w.wind_speed_kts < 12 then 'breezy'
        else 'windy'
    end as wind_category
from tide t
left join wind w on t.observed_at = w.observed_at
    );
  
  
